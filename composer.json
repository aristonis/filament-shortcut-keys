{
    "name": "aristonis/filament-shortcut-keys",
    "description": "Keyboard shortcuts for a Filament panel, assigned automatically from its resources, pages, actions and tables.",
    "keywords": [
        "aristonis",
        "laravel",
        "filament",
        "filamentphp",
        "filament-plugin",
        "filament-v5",
        "keyboard-shortcuts",
        "shortcuts",
        "hotkeys",
        "keyboard",
        "keymap",
        "accessibility",
        "filament-shortcut-keys"
    ],
    "homepage": "https://github.com/aristonis/filament-shortcut-keys",
    "support": {
        "issues": "https://github.com/aristonis/filament-shortcut-keys/issues",
        "source": "https://github.com/aristonis/filament-shortcut-keys",
        "docs": "https://aristonis.org/open-source/filament-shortcut-keys/docs"
    },
    "license": "MIT",
    "authors": [
        {
            "name": "Mekad Alibrahem",
            "email": "mekad_123@outlook.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "filament/filament": "^5.0",
        "illuminate/contracts": "^12.0|^13.0",
        "spatie/laravel-package-tools": "^1.15.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.0",
        "nunomaduro/collision": "^8.0",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^3.7|^4.0|^5.0",
        "pestphp/pest-plugin-arch": "^3.0|^4.0|^5.0",
        "pestphp/pest-plugin-laravel": "^3.0|^4.0|^5.0",
        "rector/rector": "^2.0",
        "spatie/laravel-ray": "^1.26"
    },
    "autoload": {
        "psr-4": {
            "Aristonis\\FilamentShortcutKeys\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Aristonis\\FilamentShortcutKeys\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": "@php ./vendor/bin/testbench package:discover --ansi",
        "analyse": "phpstan analyse",
        "lint": "pint",
        "refactor": "rector",
        "test": "pest --no-coverage",
        "test:coverage": "pest --coverage",
        "test:lint": "pint --test",
        "test:refactor": "rector --dry-run"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Aristonis\\FilamentShortcutKeys\\FilamentShortcutKeysServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "composer/package-versions-deprecated": true,
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
